{
  "name": "codeforge",
  "version": "0.0.1",
  "private": true,
  "description": "Local-first learn-to-code platform - CodeForge",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:desktop": "pnpm --filter desktop dev",
    "dev:cli": "pnpm --filter cli dev",
    "build": "pnpm -r build",
    "build:web": "pnpm --filter web build",
    "build:desktop": "pnpm --filter desktop build",
    "build:cli": "pnpm --filter cli build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm -r test:integration",
    "test:e2e": "pnpm --filter web test:e2e",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,yaml,yml}\"",
    "prepare": "husky install",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish",
    "db:generate": "pnpm --filter data db:generate",
    "db:migrate": "pnpm --filter data db:migrate",
    "db:studio": "pnpm --filter data db:studio",
    "i18n:extract": "pnpm --filter i18n extract",
    "i18n:compile": "pnpm --filter i18n compile"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-testing-library": "^6.2.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.0",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
{
  "name": "@codeforge/worlds",
  "version": "0.0.1",
  "description": "Phaser-based virtual worlds for social learning",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./phaser": {
      "types": "./dist/phaser/index.d.ts",
      "import": "./dist/phaser/index.mjs",
      "require": "./dist/phaser/index.js"
    },
    "./scenes": {
      "types": "./dist/scenes/index.d.ts",
      "import": "./dist/scenes/index.mjs",
      "require": "./dist/scenes/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codeforge/core": "workspace:*",
    "@codeforge/avatar": "workspace:*",
    "phaser": "^3.70.0",
    "yjs": "^13.6.10",
    "y-webrtc": "^10.3.0"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "@types/node": "^20.11.0"
  }
}
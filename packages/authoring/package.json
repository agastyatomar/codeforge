{
  "name": "@codeforge/authoring",
  "version": "0.0.1",
  "description": "Visual course authoring tools, exercise builder, content management",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./builder": {
      "types": "./dist/builder/index.d.ts",
      "import": "./dist/builder/index.mjs",
      "require": "./dist/builder/index.js"
    },
    "./exercise-builder": {
      "types": "./dist/exercise-builder/index.d.ts",
      "import": "./dist/exercise-builder/index.mjs",
      "require": "./dist/exercise-builder/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codeforge/core": "workspace:*",
    "@codeforge/course-engine": "workspace:*",
    "@codeforge/exercise-engine": "workspace:*",
    "zod": "^3.22.4",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "@types/node": "^20.11.0"
  }
}
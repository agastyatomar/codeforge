{
  "name": "@codeforge/community",
  "version": "0.0.1",
  "description": "Local-first community features: forum, posts, reactions, tech news",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./forum": {
      "types": "./dist/forum/index.d.ts",
      "import": "./dist/forum/index.mjs",
      "require": "./dist/forum/index.js"
    },
    "./news": {
      "types": "./dist/news/index.d.ts",
      "import": "./dist/news/index.mjs",
      "require": "./dist/news/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codeforge/core": "workspace:*",
    "@codeforge/data": "workspace:*",
    "zod": "^3.22.4",
    "rss-parser": "^3.13.0",
    "date-fns": "^3.3.1"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "@types/node": "^20.11.0"
  }
}
{
  "name": "@codeforge/data",
  "version": "0.0.1",
  "description": "Local-first data layer with SQLite (WASM) + IndexedDB",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite/index.d.ts",
      "import": "./dist/sqlite/index.mjs",
      "require": "./dist/sqlite/index.js"
    },
    "./dexie": {
      "types": "./dist/dexie/index.d.ts",
      "import": "./dist/dexie/index.mjs",
      "require": "./dist/dexie/index.js"
    },
    "./sync": {
      "types": "./dist/sync/index.d.ts",
      "import": "./dist/sync/index.mjs",
      "require": "./dist/sync/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "tsx scripts/generate-schema.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:studio": "tsx scripts/studio.ts"
  },
  "dependencies": {
    "dexie": "^4.0.4",
    "idb": "^8.0.0",
    "sql.js": "^1.10.3",
    "zod": "^3.22.4",
    "yjs": "^13.6.10",
    "lib0": "^0.2.89"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "@types/node": "^20.11.0",
    "@types/sql.js": "^1.4.7",
    "tsx": "^4.7.0"
  }
}
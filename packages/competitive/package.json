{
  "name": "@codeforge/competitive",
  "version": "0.0.1",
  "description": "Competitive programming platform with contests, problems, rankings",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./contest": {
      "types": "./dist/contest/index.d.ts",
      "import": "./dist/contest/index.mjs",
      "require": "./dist/contest/index.js"
    },
    "./problems": {
      "types": "./dist/problems/index.d.ts",
      "import": "./dist/problems/index.mjs",
      "require": "./dist/problems/index.js"
    },
    "./ranking": {
      "types": "./dist/ranking/index.d.ts",
      "import": "./dist/ranking/index.mjs",
      "require": "./dist/ranking/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codeforge/core": "workspace:*",
    "@codeforge/code-execution": "workspace:*",
    "@codeforge/data": "workspace:*",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "@types/node": "^20.11.0"
  }
}
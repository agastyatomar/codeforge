{
  "name": "@codeforge/code-execution",
  "version": "0.0.1",
  "description": "Multi-language code execution sandbox with WASM runtimes",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./runtimes": {
      "types": "./dist/runtimes/index.d.ts",
      "import": "./dist/runtimes/index.mjs",
      "require": "./dist/runtimes/index.js"
    },
    "./python": {
      "types": "./dist/runtimes/python/index.d.ts",
      "import": "./dist/runtimes/python/index.mjs",
      "require": "./dist/runtimes/python/index.js"
    },
    "./javascript": {
      "types": "./dist/runtimes/javascript/index.d.ts",
      "import": "./dist/runtimes/javascript/index.mjs",
      "require": "./dist/runtimes/javascript/index.js"
    },
    "./webcontainer": {
      "types": "./dist/runtimes/webcontainer/index.d.ts",
      "import": "./dist/runtimes/webcontainer/index.mjs",
      "require": "./dist/runtimes/webcontainer/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext ts,tsx",
    "lint:fix": "eslint src --ext ts,tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@codeforge/core": "workspace:*",
    "pyodide": "^0.25.1",
    "quickjs-emscripten": "^0.26.0",
    "@webcontainer/api": "^1.1.1",
    "comlink": "^4.4.1"
  },
  "devDependencies": {
    "tsup": "^8.0.2",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "@types/node": "^20.11.0"
  }
}
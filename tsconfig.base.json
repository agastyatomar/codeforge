{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "baseUrl": ".",
    "paths": {
      "@codeforge/*": ["packages/*/src"],
      "@codeforge/web/*": ["apps/web/src/*"],
      "@codeforge/desktop/*": ["apps/desktop/src/*"],
      "@codeforge/cli/*": ["apps/cli/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".turbo"]
}
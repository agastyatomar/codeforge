{
  "name": "@codeforge/cli",
  "version": "0.0.1",
  "description": "CodeForge CLI - Terminal companion",
  "type": "module",
  "bin": {
    "codeforge": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
